{
  "name": "brainrot-cash-rush",
  "servePort": 34872,
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 22,
        "CharacterJumpPower": 55,
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 4,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.49,
          0.51,
          0.61
        ],
        "OutdoorAmbient": [
          0.67,
          0.7,
          0.81
        ],
        "Brightness": 3.2,
        "ClockTime": 14.3,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future",
        "EnvironmentDiffuseScale": 0.7,
        "EnvironmentSpecularScale": 0.6,
        "ExposureCompensation": 0.3,
        "ShadowSoftness": 0.3
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
