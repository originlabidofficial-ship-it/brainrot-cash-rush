{
  "name": "brainrot-cash-rush",
  "servePort": 34872,
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$className": "Folder",
        "$path": "src/shared"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$className": "Folder",
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 22,
        "CharacterJumpPower": 58,
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 4,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$className": "Folder",
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.49, 0.51, 0.61],
        "OutdoorAmbient": [0.67, 0.7, 0.81],
        "Brightness": 3.1,
        "ClockTime": 14.2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future",
        "EnvironmentDiffuseScale": 0.75,
        "EnvironmentSpecularScale": 0.55,
        "ExposureCompensation": 0.25,
        "ShadowSoftness": 0.3
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
