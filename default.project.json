{
  "name": "brainrot-cash-rush",
  "servePort": 34872,
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 22,
        "CharacterJumpPower": 55,
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 4,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.36,
          0.4,
          0.52
        ],
        "OutdoorAmbient": [
          0.58,
          0.64,
          0.76
        ],
        "Brightness": 2.3,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future",
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.65,
        "ExposureCompensation": 0.1,
        "ShadowSoftness": 0.35
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
